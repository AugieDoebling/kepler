# Copy this file to .env and fill in the key for the llm provider selected in kepler_config.json.
# .env is gitignored, never commit real keys.

# Claude, from https://platform.claude.com
ANTHROPIC_API_KEY=

# Gemini, from https://aistudio.google.com
GEMINI_API_KEY=

# Ollama, from https://ollama.com (only needed for the web_search and web_fetch tools, not for the local model)
OLLAMA_API_KEY=
